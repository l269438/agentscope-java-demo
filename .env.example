# Copy to .env locally. Do not commit or include the key in screenshots.
DASHSCOPE_API_KEY=
DEMO_PROVIDER=dashscope
# Optional: defaults to qwen-plus for dashscope, qwen2.5:0.5b for ollama.
# DEMO_MODEL=qwen-plus
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEMO_PORT=18181
DEMO_MAX_ITERS=8
DEMO_TIMEOUT_SECONDS=120
DEMO_RUNS_DIR=runs
